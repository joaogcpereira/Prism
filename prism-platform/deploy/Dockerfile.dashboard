FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Prism.Dashboard/Prism.Dashboard.csproj -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
# Bundle the static UI into wwwroot (Program resolves it there in-container).
COPY dashboard/index.html ./wwwroot/index.html
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "prism-dashboard.dll"]
