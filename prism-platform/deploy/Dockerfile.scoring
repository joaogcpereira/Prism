FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Prism.Scoring/Prism.Scoring.csproj -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0
# Microsoft.Data.SqlClient requires ICU (no invariant globalization).
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "prism-scoring.dll"]
