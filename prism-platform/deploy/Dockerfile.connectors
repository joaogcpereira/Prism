# Build context = repo root (prism-platform/). Resolves project references.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Prism.Connectors/Prism.Connectors.csproj -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0
# Microsoft.Data.SqlClient requires ICU (no invariant globalization).
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0
WORKDIR /app
COPY --from=build /app .
# Runs to completion and exits — designed for a scheduled Container Apps Job.
ENTRYPOINT ["dotnet", "prism-connectors.dll"]
